# ─────────────────────────────────────────────────────────────
# FinPilot — environment template.  Copy to `.env` and fill in.
# NEVER commit the real `.env`.  No secrets in code, ever.
# ─────────────────────────────────────────────────────────────

# --- Core ---
ENVIRONMENT=development          # development | staging | production
PROJECT_NAME=FinPilot
TZ=Asia/Kolkata

# --- Database (Postgres + TimescaleDB + pgvector) ---
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=finpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Async SQLAlchemy URL used by the backend
DATABASE_URL=postgresql+asyncpg://finpilot:change_me_strong_password@db:5432/finpilot

# --- Redis (cache, pub/sub, rate-limit, Celery broker) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth / JWT (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=change_me_min_256_bit_random_hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth2 Google (Sign in with Google) ---
# 1. https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized redirect URI: http://localhost:8000/auth/google/callback
#    (use your deployed backend URL + /auth/google/callback in production)
# The login/register pages show the Google button automatically once these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Market data (free tiers) ---
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
# yfinance needs no key

# --- AI Copilot (ALL OPTIONAL — end users never need a key) ---
# Embeddings run locally (all-MiniLM-L6-v2) and the copilot answers keylessly
# out of the box. To upgrade generation quality, set ANY ONE of these
# server-side; providers are tried top to bottom:
GROQ_API_KEY=            # free tier: https://console.groq.com (recommended)
GEMINI_API_KEY=          # free tier: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OLLAMA_URL=              # self-hosted, e.g. http://localhost:11434
HF_API_KEY=              # optional: FinBERT sentiment via HuggingFace

# --- Email (budget/fraud alerts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@finpilot.local

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Frontend base URL (post-OAuth redirect target) ---
FRONTEND_URL=http://localhost:3000

# --- CORS (comma-separated allow-list) ---
CORS_ORIGINS=http://localhost:3000
